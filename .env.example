# Copy this file to .env and adjust to your setup.
# scripts/setup.sh generates it automatically, auto-detecting the dongle.

# Zigbee coordinator, addressed by its stable by-id path.
# Find it with: ls -l /dev/serial/by-id/
ZIGBEE_DEVICE=/dev/serial/by-id/usb-SONOFF_SONOFF_Dongle_Lite_MG21_XXXXXXXX-if00-port0

TZ=Europe/Paris

# Pi-hole admin UI password. Pick your own value — this is not auto-generated.
PIHOLE_PASSWORD=changeme
